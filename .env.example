# Copy to .env and fill in. .env is gitignored.
# Docker Compose also reads this file to expand ${VAR} in docker-compose*.yml;
# on Dokploy set the same keys in the Environment tab instead.

# --- MySQL (1C data warehouse) ---
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=kazgevim_1C
# Data-contract table built by build-ctkm-margin-base.py in the 1c-data-sync repo
BASE_TABLE=tb_ctkm_margin_base

# --- Runtime ---
TZ=Asia/Ho_Chi_Minh
# Host port published by docker-compose.yml (local run only; Dokploy ignores it)
APP_PORT=8000
# Public hostname Traefik routes to the app (docker-compose.prod.yml / Dokploy only)
DOMAIN=promo.example.com
